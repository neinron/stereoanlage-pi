[Unit]
Description=Stereoanlage guide and HDMI-CEC terminal
After=local-fs.target getty@tty1.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/stereoanlage-display/tv_console.py --user jaron
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=8
Nice=10
PrivateTmp=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
